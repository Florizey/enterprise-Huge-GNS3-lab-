frr version 10.3
frr defaults traditional
hostname FRRDocker-1
log syslog informational
service integrated-vtysh-config
!
ip route 0.0.0.0/0 192.168.11.2
ip route 192.168.1.0/24 192.168.11.2
ip route 192.168.2.0/24 192.168.11.2
!
interface eth0
 ip address 192.168.3.10/24
exit
!
interface eth2
 ip address 192.168.11.1/24
exit
!
router ospf
 network 192.168.3.0/24 area 0
 network 192.168.11.0/24 area 0
 default-information originate
exit
!
segment-routing
 traffic-eng
 exit
exit
!
