frr version 10.3
frr defaults traditional
hostname FRRDocker-4
log syslog informational
service integrated-vtysh-config
!
interface eth0
 ip address 192.168.4.10/24
exit
!
interface eth1
 ip address 192.168.0.1/24
exit
!
router ospf
 network 192.168.0.0/24 area 2
 network 192.168.4.0/24 area 2
exit
!
segment-routing
 traffic-eng
 exit
exit
!
