# Firewall for this node, including the PAT/MASQUERADE towards NAT1 out eth2
# (interface addresses and routes live in FRR, not here).
#
# The whole ruleset is kept in /etc/network/iptables.rules, which GNS3 persists
# along with this file. iptables-restore flushes and reloads every table named in
# that dump, so the line below is atomic and safe to re-run. GNS3 runs 'ifup -a -f'
# at every container start, which is what replays it -- iptables rules are kernel
# state, so nothing survives a restart on its own.
#
# To change the firewall: edit the rules live with iptables, check them, then
# write them back with
#     iptables-save > /etc/network/iptables.rules
auto eth2
iface eth2 inet manual
	up /usr/sbin/iptables-restore /etc/network/iptables.rules
