ip a
ip addr add 192.168.3.1/24
ip addr add 192.168.3.1/24 dev eth0
ip route add default via 192.168.3.10
ping 8.8.8.8
echo "nameserver 8.8.8.8" > /etc/resolv.conf 
apk add kea-dhcp4
vi /etc/kea/kea-dhcp4.conf 
kea-dhcp4 -c /etc/kea/kea-dhcp4.conf 
cat /etc/kea/kea-dhcp4.conf 
kea-dhcp4 -c /etc/kea/kea-dhcp4.conf 
vi /etc/kea/kea-dhcp4.conf 
cat /etc/kea/kea-dhcp4.conf 
mkdir /etc/kea
cat /etc/kea/kea-dhcp4.conf 
vi /etc/kea/kea-dhcp4.conf 
kea-dhcp4 -t /etc/kea/kea-dhcp4.conf
jobs
